{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rain",
      "camelcase": "Rain",
      "title": "'rain",
      "scope": "source.rain",
      "file-types": ["rain"],
      "injection-regex": "^rain$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "class-name": "TreeSitterRain"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "'rain grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/onelivesleft/tree-sitter-rain"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
